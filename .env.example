# Data
VISA_TRACKER_DATA_DIR=./data

# Collector: demo (offline) | http_json (your feed URL)
VISA_TRACKER_COLLECTOR=demo
VISA_TRACKER_FEED_URL=
VISA_TRACKER_FEED_API_KEY=

# Cadence (seconds). Public feeds: 180–300 is a good start.
VISA_TRACKER_INTERVAL_SEC=300
VISA_TRACKER_ALERT_COOLDOWN_SEC=900

# Scope
VISA_TRACKER_POSTS=mumbai,new_delhi,chennai,hyderabad,kolkata
VISA_TRACKER_VISAS=H1B,H4

# Telegram (optional — without these, alerts are logged to the DB only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard
VISA_TRACKER_DASHBOARD_HOST=127.0.0.1
VISA_TRACKER_DASHBOARD_PORT=8080
