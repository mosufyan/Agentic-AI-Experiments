# Data
VISA_TRACKER_DATA_DIR=./data

# Collectors (comma-separated): demo | http_json | auth_demo | auth
# Start with demo or demo,auth_demo for local testing.
VISA_TRACKER_COLLECTOR=demo
VISA_TRACKER_FEED_URL=
VISA_TRACKER_FEED_API_KEY=

# Cadence (seconds)
VISA_TRACKER_INTERVAL_SEC=300
VISA_TRACKER_ALERT_COOLDOWN_SEC=900

# Scope
VISA_TRACKER_POSTS=mumbai,new_delhi,chennai,hyderabad,kolkata
VISA_TRACKER_VISAS=H1B,H4

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard
VISA_TRACKER_DASHBOARD_HOST=127.0.0.1
VISA_TRACKER_DASHBOARD_PORT=8080

# ---- Phase 2 auth (OPTIONAL, check-only, higher risk) ----
# Keep OFF until you are ready to test against your own account.
VISA_TRACKER_AUTH_ENABLED=0
VISA_TRACKER_USERNAME=
VISA_TRACKER_PASSWORD=
# JSON map of lowercase question substring -> answer
VISA_TRACKER_SECURITY_QA={}
VISA_TRACKER_AUTH_BASE_URL=https://www.usvisascheduling.com
VISA_TRACKER_AUTH_HEADLESS=1
VISA_TRACKER_AUTH_INTERVAL_SEC=900
VISA_TRACKER_AUTH_JITTER_SEC=120
# Optional selector overrides if the portal DOM drifts
VISA_TRACKER_AUTH_SELECTORS_JSON=
